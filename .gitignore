node_modules
dist
*.log
.DS_Store

# local scratch output. Root-anchored like the rest of this section, so a legitimately
# named directory deeper in the tree is not silently ignored. `scratchpad/` is where
# agent working notes and throwaway logs land; a `git add -A` swept one into a commit
# before this entry existed.
/tmp/
/scratchpad/

# generated renders -- visual gate output and gallery stills
visual-out/
gallery-out/
/artifacts/capture/
/artifacts/compare/
*.gif
audio-out/

# scratch fixtures written (and deleted) by tools/mutate's own end-to-end test --
# uniquely named per run, cleaned up in a finally; this is only a safety net for an
# interrupted test run
tools/mutate/fixtures/tmp-e2e-*.test.ts
