{
  "name": "tanks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "workspaces": [
    "tools/mutate"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run verify:quick --",
    "verify:quick": "npm run typecheck && npm run test:unit --",
    "verify:build": "npm run build && npm run portability",
    "verify:visual": "npm run verify:build && npm run test:gl && npm run trace:browser && npm run visual && npm run roundtrip && npm run devtools:pages",
    "verify:full": "npm run verify:quick && npm run mutate && npm run verify:build && npm run audit:prod",
    "visual": "node tools/visual/verify.mjs dist --check",
    "screens": "node tools/screens/run.mjs",
    "screens:sweep": "node tools/screens/sweep.mjs",
    "screens:compare": "node tools/screens/compare.mjs",
    "screens:check": "node tools/screens/check.mjs",
    "screens:accept": "node tools/screens/accept.mjs",
    "roundtrip": "node tools/visual/roundtrip.mjs dist",
    "devtools:pages": "node tools/devtools-pages/run.mjs dist",
    "portability": "node tools/portability/check.mjs dist",
    "test:gl": "node tools/gl/run.mjs",
    "trace:browser": "node tools/baseline/run.mjs",
    "trace:safari": "node tools/baseline/safari.mjs",
    "trace:beacon:check": "node tools/baseline/beacon-check.mjs",
    "gallery": "node tools/gallery/run.mjs",
    "ai:sweep": "node tools/ai-sweep/run.mjs",
    "capture": "node tools/capture/run.mjs",
    "capture:compare": "node tools/compare/run.mjs",
    "audio": "node tools/audio/render.mjs",
    "issues:audit": "node tools/issues/run.mjs audit",
    "issues:maintain": "node tools/issues/run.mjs event",
    "issues:reconcile": "node tools/issues/run.mjs reconcile",
    "issues:relationships": "node tools/issues/migrate-relationships.mjs",
    "issues:snapshot": "node tools/issues/run.mjs snapshot",
    "issues:frontier": "node tools/issues/run.mjs frontier",
    "docs:check": "node tools/docs/check.mjs",
    "docs:index": "node tools/docs/index.mjs",
    "lint:css": "node tools/css-integrity/run.mjs",
    "mutate": "node tools/mutate/run.mjs",
    "hud:closure": "node tools/hud-closure/analyze.mjs",
    "mutate:smoke": "npm run mutate -- --only capture-prerequisite-error-drops-the-ci-pin",
    "audit:prod": "node tools/audit/prod.mjs",
    "lint:workflows": "node tools/workflow-lint/run.mjs",
    "devflags:doc": "vite-node tools/devflags/generate.mjs",
    "bench:summarize": "vite-node tools/bench/summarize.mjs --",
    "bench:contrast": "vite-node tools/bench/check-contrast.mjs --",
    "tanks:doc": "vite-node tools/tanks/generate.mjs",
    "notices": "node tools/notices/generate.mjs",
    "legal": "node tools/legal/generate.mjs",
    "tank-assets": "vite-node tools/tank-assets/generate.mjs"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
